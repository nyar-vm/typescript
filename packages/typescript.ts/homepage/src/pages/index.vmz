<script client>
export default class IndexPage {
    kicker = "TypeScript language services · Node-API";
    titleLead = "Parse TypeScript";
    titleEm = "without leaving Node";
    lede = "A native binding over Boost language.typescript and data.text.typescript: syntax trees, tokens, diagnostics and CST formatting, packaged for every supported host.";
    footer = "Built with the VMZ framework.";

    commands = [
        { name: "parse", line: "typescript parse file.ts", description: "Syntax tree with byte spans for every node and leaf." },
        { name: "tokens", line: "typescript tokens file.ts", description: "Lexical tokens in source order, ready for tooling." },
        { name: "check", line: "typescript check src/*.ts", description: "Parser diagnostics for one or many files." },
        { name: "format", line: "typescript format file.ts", description: "CST formatting that keeps every token text intact." },
    ];

    capabilities = [
        { id: "spans", label: "Byte-accurate spans shared by every command" },
        { id: "diagnostics", label: "Diagnostics surfaced instead of swallowed" },
        { id: "override", label: "TYPESCRIPT_NATIVE override for validating fresh builds" },
        { id: "harness", label: "Same addon used by typescript-harness diagnostics" },
    ];

    sample = "import { parse, check } from '@nyar/typescript';\n\nconst source = 'const x: number = 1;';\nconst outcome = parse(source);\nconsole.log(outcome.ok, outcome.tokenCount);\n\nfor (const message of check(source)) {\n  console.error(message);\n}";

    packages = [
        { name: "@nyar/typescript", description: "CLI and API surface; pulls the matching platform binding." },
        { name: "@nyar/typescript-harness", description: "Diagnostics and parse-latency tuning loop." },
        { name: "@nyar/typescript-skills", description: "Agent guides for parsing and triage workflows." },
        { name: "@nyar/typescript-<platform>", description: "Prebuilt .node addon for win32, linux and macOS." },
    ];
}
</script>
